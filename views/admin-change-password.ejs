<%
  const sk = (lang || 'en') === 'sk';
  const L = sk ? {
    title: 'Zmeniť heslo', current: 'Súčasné heslo', next: 'Nové heslo', confirm: 'Nové heslo znova', save: 'Uložiť nové heslo',
    hint: 'Aspoň 8 znakov. Prihlasovacie meno sa nemení.',
    done: 'Heslo bolo zmenené. Prehliadač si pri ďalšom kroku vypýta prihlásenie znova: zadajte to isté meno a nové heslo.',
    errors: { current: 'Súčasné heslo nie je správne.', short: 'Nové heslo musí mať aspoň 8 znakov.', mismatch: 'Nové heslá sa nezhodujú.', server: 'Heslo sa nepodarilo uložiť. Skúste to znova.' }
  } : {
    title: 'Change password', current: 'Current password', next: 'New password', confirm: 'New password again', save: 'Save new password',
    hint: 'At least 8 characters. The user name stays the same.',
    done: 'The password was changed. On your next step the browser will ask you to sign in again: enter the same user name and the new password.',
    errors: { current: 'The current password is not correct.', short: 'The new password needs at least 8 characters.', mismatch: 'The new passwords do not match.', server: 'The password could not be saved. Please try again.' }
  };
%>
<%- include('admin-layout-top', { title: L.title, active: 'change-password', lang: lang || 'en', useDb: true }) %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-key me-2"></i><%= L.title %></h4>
        </div>
        <div class="card-body">
          <% if (done) { %><div class="alert alert-success"><%= L.done %></div><% } %>
          <% if (error) { %><div class="alert alert-danger"><%= L.errors[error] || L.errors.server %></div><% } %>
          <form method="post" action="/admin/change-password?lang=<%= lang || 'en' %>" autocomplete="off">
            <div class="mb-3">
              <label class="form-label" for="cpCurrent"><%= L.current %></label>
              <input class="form-control" type="password" id="cpCurrent" name="current" required autocomplete="current-password">
            </div>
            <div class="mb-3">
              <label class="form-label" for="cpNew"><%= L.next %></label>
              <input class="form-control" type="password" id="cpNew" name="password" required minlength="8" autocomplete="new-password">
              <div class="form-text"><%= L.hint %></div>
            </div>
            <div class="mb-4">
              <label class="form-label" for="cpConfirm"><%= L.confirm %></label>
              <input class="form-control" type="password" id="cpConfirm" name="confirm" required minlength="8" autocomplete="new-password">
            </div>
            <button class="btn btn-primary" type="submit"><i class="fas fa-save me-2"></i><%= L.save %></button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('admin-layout-bottom') %>
