<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="utf-8">
    <title><%= page.title ? page.title + ' · ' : '' %>SkillUp Slovakia</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css?v=20251010-2" rel="stylesheet">
    <!-- SkillUp theme: teal + gold from the logo, light and dark mode (loaded last on purpose) -->
    <link href="/css/skillup-theme.css?v=20261123-8" rel="stylesheet">
    <script>
      /* theme before first paint: saved choice, else light (new visitors start in light mode) */
      (function () { var t = null; try { t = localStorage.getItem('su-theme'); } catch (e) {} if (t !== 'light' && t !== 'dark') t = 'light'; document.documentElement.setAttribute('data-theme', t); })();
    </script>
</head>

<body>
    <% if (typeof t === 'undefined' || !t) { 
        var t = function(k){ try { return (typeof lang !== 'undefined' && lang.toLowerCase() === 'sk') ? k : k; } catch(e){ return k; } } 
    } %>
    <%
        const __m = (typeof menu !== 'undefined' && Array.isArray(menu)) ? menu : [];
        const __about = __m.find(i => i.slug === 'about-us') || __m.find(i => i.slug === 'about');
        const __gdpr = __m.find(i => i.slug === 'gdpr');
        const __contact = __m.find(i => i.slug === 'contact');
        const __cp = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
        const __nav = [
            ['/', t('home'), __cp === '/'],
            __about ? ['/page/' + __about.slug, __about.label || t('about'), __cp === '/page/' + __about.slug] : null,
            ['/themes', t('themes'), __cp === '/themes' || __cp.startsWith('/themes/')],
            ['/focus-areas', t('focusAreas'), __cp === '/focus-areas'],
            ['/events', t('events'), __cp === '/events' || __cp.startsWith('/events/')],
            ['/team', t('team'), __cp === '/team' || __cp.startsWith('/team/')],
            ['/partners', t('partners'), __cp === '/partners'],
            ['/news', t('news'), __cp === '/news' || __cp.startsWith('/news/')],
            ['/documents', t('documents'), __cp === '/documents'],
            __gdpr ? ['/page/' + __gdpr.slug, __gdpr.label || t('gdpr'), __cp === '/page/' + __gdpr.slug] : null
        ].filter(Boolean);
        const __href = (u) => u + (u.includes('?') ? '&' : '?') + 'lang=' + lang;
    %>
    <!-- Header: one sticky row (logo, menu, languages, contact) -->
    <header class="su-header" id="suHeader">
        <div class="container su-header-inner">
            <a href="/?lang=<%= lang %>" class="su-logo" aria-label="SkillUp Slovakia">
                <img src="/img/logo.png" alt="SkillUp Slovakia" />
            </a>
            <nav class="su-nav" id="suNav" aria-label="Main">
                <% __nav.forEach(([u, label, on]) => { %>
                    <a href="<%= __href(u) %>" class="su-nav-link <%= on ? 'active' : '' %>"><%= label %></a>
                <% }) %>
                <% if (__contact) { %>
                    <a href="<%= __href('/page/' + __contact.slug) %>" class="su-nav-link su-nav-contact-mobile <%= __cp === '/page/' + __contact.slug ? 'active' : '' %>"><%= __contact.label || t('contact') %></a>
                <% } %>
                <div class="su-lang su-lang-mobile">
                    <a class="<%= lang==='en' ? 'active' : '' %>" href="?lang=en">EN</a><a class="<%= lang==='sk' ? 'active' : '' %>" href="?lang=sk">SK</a><a class="<%= lang==='hu' ? 'active' : '' %>" href="?lang=hu">HU</a>
                </div>
            </nav>
            <div class="su-actions">
                <div class="su-lang">
                    <a class="<%= lang==='en' ? 'active' : '' %>" href="?lang=en">EN</a><a class="<%= lang==='sk' ? 'active' : '' %>" href="?lang=sk">SK</a><a class="<%= lang==='hu' ? 'active' : '' %>" href="?lang=hu">HU</a>
                </div>
                <button type="button" class="su-theme" id="suTheme" aria-label="Light / dark"><i class="fas fa-moon"></i><i class="fas fa-sun"></i></button>
                <% if (__contact) { %>
                    <a href="<%= __href('/page/' + __contact.slug) %>" class="su-btn su-btn-main su-header-cta"><%= __contact.label || t('contact') %></a>
                <% } %>
                <button type="button" class="su-burger" id="suBurger" aria-label="<%= t('menu') %>" aria-expanded="false" aria-controls="suNav"><span></span><span></span><span></span></button>
            </div>
        </div>
    </header>

    <!-- Back-to-list will be shown alongside the section header below if provided -->

    <!-- Hero (homepage only). Light mode: floating photo stack on soft colour fields. Dark mode: arch photo on deep teal. -->
    <% if (typeof slider !== 'undefined' && Array.isArray(slider) && slider.length > 0) { %>
        <% const __s = slider.find(x => x && (x.title || x.caption)) || {}; %>
        <% const __esc = (v) => String(v || '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); %>
        <% const __title = __esc(__s.title).replace(/\*([^*]+)\*/, '<em>$1<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14 C 70 2, 150 2, 296 12"/></svg></em>'); %>
        <% const __ph = ((typeof heroPhotos !== 'undefined' && Array.isArray(heroPhotos)) ? heroPhotos : []).filter(Boolean); %>
        <% const __st = (typeof heroStats !== 'undefined' && Array.isArray(heroStats)) ? heroStats[1] || heroStats[0] : null; %>
        <% const __aboutHref = (typeof menu !== 'undefined' && Array.isArray(menu) && (menu.find(i => i.slug === 'about-us') || menu.find(i => i.slug === 'about'))) ? '/page/' + (menu.find(i => i.slug === 'about-us') || menu.find(i => i.slug === 'about')).slug + '?lang=' + lang : ''; %>
        <section class="su-hero">
            <div class="su-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="container su-hero-grid">
                <div class="su-hero-copy">
                    <h1 class="su-hero-title" id="suHeroTitle"><%- __title %></h1>
                    <% if (__s.caption) { %><p class="su-hero-lead"><%= __s.caption %></p><% } %>
                    <div class="su-hero-actions">
                        <a class="su-btn su-btn-main" href="<%= __s.link || ('/events?lang=' + lang) %>"><%= __s.link ? t('learnMore') : t('viewEvents') %></a>
                        <% if (__aboutHref) { %><a class="su-btn su-btn-quiet" href="<%= __aboutHref %>"><%= t('about') %></a><% } %>
                    </div>
                </div>
                <% if (__ph.length) { %>
                <div class="su-hero-visual" aria-hidden="true">
                    <div class="su-stack">
                        <% __ph.slice(0, 3).forEach((u, i) => { %><div class="su-ph su-ph-<%= i + 1 %>"><img src="<%= u %>" alt="" <%= i === 0 ? 'fetchpriority="high"' : '' %>></div><% }) %>
                    </div>
                    <div class="su-arch-wrap">
                        <div class="su-arch"><img src="<%= __ph[0] %>" alt=""></div>
                        <div class="su-ring"></div>
                        <% if (__ph[1]) { %><div class="su-small"><img src="<%= __ph[1] %>" alt=""></div><% } %>
                    </div>
                    <% if (__st && __st.label) { %><div class="su-chip"><strong><%= __st.value %><%= __st.suffix || '' %></strong><span><%= __st.label %></span></div><% } %>
                </div>
                <% } %>
            </div>
        </section>
    <% } %>

    <!-- Optional Page Hero injected by route (e.g., contact map) -->
    <% if (typeof hero !== 'undefined' && hero) { %>
        <%- hero %>
    <% } %>

    <!-- Main Content Start -->
    <% if (typeof rawContent !== 'undefined' && rawContent) { %>
        <%- page.content %>
    <% } else { %>
                <div class="container-fluid py-5">
            <div class="container">
                                <% if (typeof sectionHeader !== 'undefined' && sectionHeader) { %>
                                    <div class="mb-4">
                                        <div class="section-title-bar">
                                            <div class="bar"></div>
                                            <span class="section-title text-warning"><%= sectionHeader.kicker || '' %></span>
                                            <div class="bar"></div>
                                        </div>
                                        <% if (sectionHeader.heading) { %>
                                            <div class="position-relative">
                                                <div class="text-center mx-auto wow fadeIn" data-wow-delay="0.1s" style="max-width: 800px;">
                                                    <h1 class="display-6 mb-4" style="font-family:'Josefin Sans',sans-serif; font-weight:700;"><%= sectionHeader.heading %></h1>
                                                    <% if (sectionHeader.subheading) { %>
                                                        <p class="text-muted"><%= sectionHeader.subheading %></p>
                                                    <% } %>
                                                </div>
                                                <% if (typeof backLink !== 'undefined' && backLink) { %>
                                                    <a href="<%= backLink %>" class="btn btn-warning btn-sm position-absolute top-0 end-0" style="border-radius:20px;">
                                                        <i class="fas fa-arrow-left me-1"></i><%= (typeof t === 'function' ? t('backToList') : 'Back to list') %>
                                                    </a>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="bg-white rounded p-4">
                                                    <% if (page.image_url) { %>
                                                        <div class="mb-4">
                                                            <img src="<%= page.image_url %>" alt="<%= page.title %>" class="img-fluid rounded w-100" style="max-height:420px; object-fit:cover;" />
                                                        </div>
                                                    <% } %>
                                                    <% if (page.title && !(typeof sectionHeader !== 'undefined' && sectionHeader && sectionHeader.heading)) { %>
                                                        <h1 class="mb-4"><%= page.title %></h1>
                                                    <% } %>
                            <div class="content"><%- page.content %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
    <!-- Main Content End -->

    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-light footer wow fadeIn" data-wow-delay="0.1s">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-primary mb-3">
                        <img src="/img/logo.png" alt="SkillUp Slovakia" class="img-fluid" style="max-height:72px; width:auto;" />
                    </h4>
                    <% const sc = (typeof site !== 'undefined' && site.contact) ? site.contact : {}; %>
                    <% 
                        const hasFb = !!(sc.facebook && (''+sc.facebook).trim());
                        const hasTw = !!(sc.twitter && (''+sc.twitter).trim());
                        const hasIg = !!(sc.instagram && (''+sc.instagram).trim());
                        const hasLi = !!(sc.linkedin && (''+sc.linkedin).trim());
                        const hasYt = !!(sc.youtube && (''+sc.youtube).trim());
                        const hasAnySocial = hasFb || hasTw || hasIg || hasLi || hasYt;
                    %>
                    <% if (hasAnySocial) { %>
                    <div class="d-flex pt-2 mb-3">
                        <% if (hasTw) { %><a class="btn btn-outline-light btn-social me-2" href="<%= sc.twitter %>" target="_blank" rel="noopener" aria-label="Twitter"><i class="fab fa-twitter"></i></a><% } %>
                        <% if (hasFb) { %><a class="btn btn-outline-light btn-social me-2" href="<%= sc.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a><% } %>
                        <% if (hasIg) { %><a class="btn btn-outline-light btn-social me-2" href="<%= sc.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a><% } %>
                        <% if (hasYt) { %><a class="btn btn-outline-light btn-social me-2" href="<%= sc.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube"></i></a><% } %>
                        <% if (hasLi) { %><a class="btn btn-outline-light btn-social" href="<%= sc.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a><% } %>
                    </div>
                    <% } %>
                    <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i><%= (typeof site !== 'undefined' && site.contact && site.contact.address) ? site.contact.address : 'Bratislava, Slovakia' %></p>
                    <p class="mb-2"><i class="fa fa-phone-alt me-3"></i><%= (typeof site !== 'undefined' && site.contact && site.contact.phone) ? site.contact.phone : '+421 123 456 789' %></p>
                    <p class="mb-2"><i class="fa fa-envelope me-3"></i><%= (typeof site !== 'undefined' && site.contact && site.contact.email) ? site.contact.email : 'info@skillupslovakia.com' %></p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-primary mb-3"><%= t('quickLinks') %></h4>
                    <a class="btn btn-link text-light" href="/?lang=<%= lang %>"><%= t('home') %></a>
                                                            <% if (menu && menu.length > 0) { %>
                                                                <% const aboutItem = (menu.find(item => item.slug === 'about-us') || menu.find(item => item.slug === 'about')); %>
                                                                <% if (aboutItem) { %>
                                                                    <a class="btn btn-link text-light" href="/page/<%= aboutItem.slug %>?lang=<%= lang %>"><%= t('about') %></a>
                                                                <% } %>
                                                            <% } %>
                                        <a class="btn btn-link text-light" href="/focus-areas?lang=<%= lang %>"><%= t('focusAreas') %></a>
                    <a class="btn btn-link text-light" href="/themes?lang=<%= lang %>"><%= t('themes') %></a>
                    <a class="btn btn-link text-light" href="/events?lang=<%= lang %>"><%= t('events') %></a>
                    <a class="btn btn-link text-light" href="/team?lang=<%= lang %>"><%= t('team') %></a>
                    <a class="btn btn-link text-light" href="/partners?lang=<%= lang %>"><%= t('partners') %></a>
                    <a class="btn btn-link text-light" href="/news?lang=<%= lang %>"><%= t('news') %></a>
                    <a class="btn btn-link text-light" href="/documents?lang=<%= lang %>"><%= t('documents') %></a>
                    <% if (menu && menu.length > 0) { %>
                      <% const gdprItem = menu.find(item => item.slug === 'gdpr'); %>
                                                                    <% if (gdprItem) { %>
                                                                        <a class="btn btn-link text-light" href="/page/<%= gdprItem.slug %>?lang=<%= lang %>"><%= t('gdpr') %></a>
                                                                    <% } %>
                      <% const contactItem = menu.find(item => item.slug === 'contact'); %>
                                                                    <% if (contactItem) { %>
                                                                        <a class="btn btn-link text-light" href="/page/<%= contactItem.slug %>?lang=<%= lang %>"><%= t('contact') %></a>
                                                                    <% } %>
                    <% } %>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-primary mb-3"><%= t('languages') %></h4>
                    <a class="btn btn-link text-light" href="?lang=en">English</a>
                    <a class="btn btn-link text-light" href="?lang=sk">Slovenčina</a>
                    <a class="btn btn-link text-light" href="?lang=hu">Magyar</a>
                </div>
                <% const __galleryAll = (typeof footerGallery !== 'undefined' && Array.isArray(footerGallery)) ? footerGallery : []; %>
                <% if (__galleryAll.length > 0) { %>
                <div class="col-lg-3 col-md-6">
                    <% const __galTitleMap = { en: 'Gallery', sk: 'Galéria', hu: 'Galéria' }; %>
                    <h4 class="text-primary mb-3"><%= __galTitleMap[(lang||'en').toLowerCase()] || 'Gallery' %></h4>
                    <% const __gallery = (typeof footerGallery !== 'undefined' && Array.isArray(footerGallery)) ? footerGallery : []; %>
                    <% if (__gallery.length > 0) { %>
                    <div class="row g-2">
                        <% __gallery.slice(0,9).forEach(function(u){ %>
                        <div class="col-4">
                            <a href="<%= u %>" class="lightbox d-block" aria-label="Open image">
                                <img src="<%= u %>" alt="Gallery image" class="img-fluid rounded" style="height:70px; width:100%; object-fit:cover;" />
                            </a>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <!-- Footer End -->

    <!-- Copyright Start -->
    <div class="container-fluid bg-dark text-light py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; <%= new Date().getFullYear() %> <a class="border-bottom" href="/?lang=<%= lang %>">SkillUp Slovakia</a>, <%= t('allRightsReserved') %>
                </div>
                <div class="col-md-6 text-center text-md-end"></div>
            </div>
        </div>
    </div>
    <!-- Copyright End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-0 back-to-top"><i class="bi bi-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/wow/wow.min.js"></script>
    <script src="/lib/easing/easing.min.js"></script>
    <script src="/lib/waypoints/waypoints.min.js"></script>
    <script src="/lib/counterup/counterup.min.js"></script>
    <script src="/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="/js/main.js"></script>
    <script src="/js/skillup-theme.js?v=20261123-8"></script>
        <script>
            // Simple, dependency-free lightbox for elements with class="lightbox"
            (function(){
                function ensureLightbox(){
                    if(document.getElementById('lightboxModal')) return;
                    const modal = document.createElement('div');
                    modal.id = 'lightboxModal';
                    modal.style.position = 'fixed';
                    modal.style.inset = '0';
                    modal.style.background = 'rgba(0,0,0,.85)';
                    modal.style.display = 'none';
                    modal.style.alignItems = 'center';
                    modal.style.justifyContent = 'center';
                    modal.style.zIndex = '1055';
                    modal.innerHTML = `
                        <div id="lightboxInner" style="max-width:90vw; max-height:90vh; position:relative;">
                            <button id="lightboxClose" aria-label="Close" style="position:absolute; top:-12px; right:-12px; background:#fff; border:none; border-radius:50%; width:36px; height:36px; box-shadow:0 2px 8px rgba(0,0,0,.3);">
                                &times;
                            </button>
                            <img id="lightboxImage" src="" alt="Preview" style="max-width:90vw; max-height:90vh; border-radius:8px; box-shadow:0 10px 30px rgba(0,0,0,.4); object-fit:contain;" />
                        </div>`;
                    document.body.appendChild(modal);

                    function hide(){ modal.style.display='none'; document.getElementById('lightboxImage').src=''; }
                    modal.addEventListener('click', (e)=>{ if(e.target===modal) hide(); });
                    document.getElementById('lightboxClose').addEventListener('click', hide);
                    document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') hide(); });
                }
                function openLightbox(src){
                    ensureLightbox();
                    const modal = document.getElementById('lightboxModal');
                    const img = document.getElementById('lightboxImage');
                    img.src = src;
                    modal.style.display = 'flex';
                }
                document.addEventListener('click', function(e){
                    const a = e.target.closest('a.lightbox');
                    if(!a) return;
                    const href = a.getAttribute('href');
                    if(!href) return;
                    e.preventDefault();
                    openLightbox(href);
                });
            })();
        </script>
                <script>
                    // Copy-to-clipboard for share buttons
                    (function(){
                        async function copy(text){
                            try{
                                await navigator.clipboard.writeText(text);
                                return true;
                            }catch{
                                const ta = document.createElement('textarea');
                                ta.value = text; document.body.appendChild(ta); ta.select();
                                try{ document.execCommand('copy'); } finally { document.body.removeChild(ta); }
                                return true;
                            }
                        }
                        document.addEventListener('click', async (e)=>{
                            const a = e.target.closest('a.copy-link');
                            if(!a) return;
                            e.preventDefault();
                            const val = a.getAttribute('data-copy') || '';
                            if(!val) return;
                            const ok = await copy(val);
                            if(ok){
                                const old = a.innerHTML;
                                const label = (window.__T_COPIED__ || 'Copied');
                                a.innerHTML = '<i class="fas fa-check me-1"></i>' + label;
                                setTimeout(()=>{ a.innerHTML = old; }, 1500);
                            }
                        });
                    })();
                </script>
        <script>
            // expose translated 'Copied' to client
            (function(){
                try{
                    var lang = (document.documentElement.getAttribute('lang')||'en').toLowerCase();
                    var map = { en: 'Copied', sk: 'Skopírované', hu: 'Másolva' };
                    window.__T_COPIED__ = map[lang] || 'Copied';
                }catch(e){ window.__T_COPIED__ = 'Copied'; }
            })();
        </script>
</body>

</html>